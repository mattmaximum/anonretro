NODE_ENV=production
PORT=3000
DATABASE_PATH=/var/data/anonretro/anonretro.db
ALLOWED_ORIGINS=https://yourdomain.com
METRICS_USER=admin
METRICS_PASSWORD=changeme

# Clerk auth (https://dashboard.clerk.com → API Keys)
CLERK_SECRET_KEY=sk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# Lemon Squeezy (https://app.lemonsqueezy.com → Settings → Webhooks / Products)
# LEMON_SQUEEZY_WEBHOOK_SECRET=  # Signing secret from the webhook config page
# VITE_LEMON_SQUEEZY_CHECKOUT_URL=  # Product checkout URL (e.g. https://your-store.lemonsqueezy.com/buy/variant-id)
